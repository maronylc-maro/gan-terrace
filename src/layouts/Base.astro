---
// 全ページ共通の枠（ヘッダー・メニュー・フッター・メタ情報）
import { canonical, paths } from '../lib/urls';

interface Props {
  title: string;
  description: string;
  /** このページのパス（canonical に使う）。例: '/purpose' */
  path: string;
  /** メニューで強調する項目 */
  active?: 'top' | 'event' | 'news' | 'articles' | 'links';
  /** SNS共有などに使う画像のURL（記事のアイキャッチなど） */
  ogImage?: string;
  /** ページの種類（記事は 'article'） */
  ogType?: 'website' | 'article';
  /** 検索エンジン向けの構造化データ（JSON-LD） */
  jsonLd?: Record<string, unknown>;
}

const { title, description, path, active, ogImage, ogType = 'website', jsonLd } = Astro.props;
const url = canonical(path);

const nav = [
  { key: 'top', label: 'TOP', href: `${paths.home}#purpose` },
  { key: 'event', label: 'イベント', href: paths.calendar },
  { key: 'news', label: '新着一覧', href: `${paths.home}#news` },
  { key: 'articles', label: '読みもの', href: paths.articles },
  { key: 'links', label: 'リンク集', href: paths.facilities },
];
---

<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="がんテラス" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <link rel="canonical" href={url} />
    <link rel="stylesheet" href="/css/style.css" />
    {
      jsonLd && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')}
        />
      )
    }
  </head>
  <body>
    <header class="site-header">
      <div class="site-header-inner">
        <a class="site-logo" href={paths.home}>がんテラス</a>

        <nav class="global-nav">
          {
            nav.map((item) => (
              <a href={item.href} class={item.key === active ? 'active' : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <a
        class="contact-link"
        href="https://forms.gle/tAPAv9wksziPmcej7"
        target="_blank"
        rel="noopener">お問い合わせ</a
      >
      <p class="footer-note">
        <svg class="footer-mark" aria-hidden="true" viewBox="0 0 24 24"><path d="M12 3c-2.8 0-4.5 2-4.5 4.2 0 2.2 1.6 4 3.2 6.1L7 21h3l2-4.2L14 21h3l-3.7-7.7c1.6-2.1 3.2-3.9 3.2-6.1C16.5 5 14.8 3 12 3zM12 5.2c1.4 0 2.3 1 2.3 2.1 0 1.1-.9 2.3-2.3 4-1.4-1.7-2.3-2.9-2.3-4 0-1.1.9-2.1 2.3-2.1z"/></svg>
        <span>© がんテラス　gan-terrace.link</span>
      </p>
    </footer>

    <slot name="scripts" />
  </body>
</html>
