---
import Base from '../layouts/Base.astro';
import { events, formatMonth, formatShortDate, todayJst } from '../lib/data';
import { paths } from '../lib/urls';

const TITLE = 'イベントカレンダー｜がんテラス';
const DESCRIPTION =
  '関西で開かれる、がん患者さんとご家族向けの交流会・講座・相談会などのイベント情報。月・週・リスト表示で探せて、気になるイベントはGoogleカレンダーに追加できます。';

// ブラウザ側のカレンダー（月送り・ポップアップなど）が使うデータ。
// </script> と誤認されないよう、< は < に置き換えて埋め込む。
const eventsJson = JSON.stringify(events).replace(/</g, '\\u003c');

// JavaScript が動く前（や、動かない環境・検索エンジン）にも見えるよう、
// これから開催されるイベントを月ごとにまとめてHTMLに書き出しておく。
// カレンダーが表示されると、この一覧は置き換わる。
const today = todayJst();
const upcoming = events
  .filter((e) => e.date >= today)
  .sort((a, b) => a.date.localeCompare(b.date));

const byMonth = new Map<string, typeof upcoming>();
for (const ev of upcoming) {
  const key = formatMonth(ev.date);
  if (!byMonth.has(key)) byMonth.set(key, []);
  byMonth.get(key)!.push(ev);
}
const months = [...byMonth.entries()];
---

<Base title={TITLE} description={DESCRIPTION} path={paths.calendar} active="event">
  <main class="container">
    <h1 class="page-title">イベントカレンダー</h1>

    <div id="filter-note"></div>

    <div class="calendar-toolbar">
      <div class="calendar-nav">
        <button id="nav-prev">＜</button>
        <span class="calendar-title" id="calendar-title"></span>
        <button id="nav-next">＞</button>
        <button id="nav-today">今日</button>
      </div>
      <div class="view-switch">
        <button id="view-month" class="active">月</button>
        <button id="view-week">週</button>
        <button id="view-list">リスト</button>
      </div>
    </div>

    <div id="calendar-body">
      {
        months.map(([month, list]) => (
          <section class="ssr-month">
            <h2>{month}</h2>
            <ul class="ssr-events">
              {list.map((ev) => (
                <li>
                  <span class="ssr-date">{formatShortDate(ev.date)}</span>
                  <strong class="ssr-title">{ev.title}</strong>
                  <span class="ssr-place">{ev.place}</span>
                  <p class="ssr-summary">{ev.summary}</p>
                  {ev.link && (
                    <a href={ev.link} target="_blank" rel="noopener">
                      詳細
                    </a>
                  )}
                </li>
              ))}
            </ul>
          </section>
        ))
      }
      {months.length === 0 && <p class="empty-note">現在、予定されているイベントはありません</p>}
    </div>
  </main>

  <Fragment slot="scripts">
    <div class="overlay" id="event-overlay" onclick="if(event.target===this) closeEventPopup()">
      <div class="popup" id="event-popup-body"></div>
    </div>

    <script id="events-data" type="application/json" is:inline set:html={eventsJson} />
    <script is:inline src="/js/config.js"></script>
    <script is:inline src="/js/likes.js"></script>
    <script is:inline src="/js/common.js"></script>
    <script is:inline src="/js/calendar.js"></script>
  </Fragment>
</Base>
