---
import Base from '../layouts/Base.astro';
import { events, news, purposes, formatDate, todayJst } from '../lib/data';
import { articles, LISTED_KINDS } from '../lib/cms';
import { articlePath, purposeCat } from '../lib/urls';

const TITLE = 'がんテラス｜関西のがん患者さんとご家族の「見つける」ポータルサイト';
const DESCRIPTION =
  '関西のがん患者さんとご家族が「集う・動く・学ぶ・装う」場を見つけるためのポータルサイト。地域の患者会や病院の取り組み、イベント情報、施設・団体のリンク集をまとめています。';

// 開催日が過ぎたイベントは新着から外す（当日は残す）
const today = todayJst();
const upcoming = events.filter((e) => e.date >= today);

// スプレッドシートの下の行が新しいので、逆順にして「登録が新しい順」にする
const eventNews = [...upcoming].reverse().slice(0, 20);

// お知らせ（スプレッドシート）と、読みもの（microCMSの記事）をまとめて、日付の新しい順にする。
// 読みものは、道案内・ブログ・お知らせだけを載せる（固定ページは載せない）
const otherNews = [
  ...news.map((n) => ({ date: n.date, title: n.title, link: n.link, tag: '', internal: false })),
  ...articles
    .filter((a) => (LISTED_KINDS as string[]).includes(a.kind))
    .map((a) => ({ date: a.date, title: a.title, link: articlePath(a.id), tag: a.kind, internal: true })),
]
  .sort((a, b) => b.date.localeCompare(a.date))
  .slice(0, 20);
---

<Base title={TITLE} description={DESCRIPTION} path="/">
  <section class="hero">
    <svg class="hero-leaf" aria-hidden="true" viewBox="0 0 600 600" fill="none" stroke-linecap="round" stroke-linejoin="round">
      <path d="M300 400C420 300 520 120 470 40C430 -10 340 80 300 400"></path>
      <path d="M300 400C220 330 120 230 80 250C40 280 140 360 300 400"></path>
      <path d="M300 400C340 470 420 520 600 500"></path>
      <path d="M300 400C280 470 240 540 170 600"></path>
    </svg>
    <div class="hero-inner">
      <p class="hero-area">
        <svg class="hero-mark" aria-hidden="true" viewBox="0 0 24 24"><path d="M12 3c-2.8 0-4.5 2-4.5 4.2 0 2.2 1.6 4 3.2 6.1L7 21h3l2-4.2L14 21h3l-3.7-7.7c1.6-2.1 3.2-3.9 3.2-6.1C16.5 5 14.8 3 12 3zM12 5.2c1.4 0 2.3 1 2.3 2.1 0 1.1-.9 2.3-2.3 4-1.4-1.7-2.3-2.9-2.3-4 0-1.1.9-2.1 2.3-2.1z"/></svg>
        <span>大阪・兵庫・奈良</span>
      </p>
      <h1 class="hero-title">がんテラス</h1>
      <p class="hero-lead">関西のがん患者さんとご家族の<br />「見つける」ポータルサイト</p>
      <p class="hero-text">
        大阪・兵庫・奈良の、がん患者会・がんサロン・アピアランスケア・相談窓口を探せます。
      </p>
      <div class="hero-actions">
        <a class="btn-primary" href="#purpose">目的から探す</a>
        <a class="btn-outline" href="/calendar">イベントカレンダー</a>
      </div>
    </div>
  </section>

  <main class="top-main">
    <section class="top-purpose anchor-target" id="purpose">
      <div class="block-head">
        <h2>目的別情報</h2>
      </div>
      <div class="purpose-grid" id="purpose-grid">
        {
          purposes.map((cat) => (
            <a class="purpose-card" href={purposeCat(cat.id)}>
              <img src={cat.image} alt="" loading="lazy" />
              <h3>{cat.category}</h3>
              <p class="purpose-desc">{cat.desc}</p>
              <span class="purpose-more">一覧を見る →</span>
            </a>
          ))
        }
      </div>
    </section>

  </main>

  <section class="news-band anchor-target" id="news">
    <div class="news-band-inner">
      <h2>新着一覧</h2>
      <div class="news-columns">
        <div class="news-col">
          <h3>イベント新着</h3>
          <ul class="news-list" id="event-news-list">
            {
              eventNews.map((item) => (
                <li data-date={item.date}>
                  <span class="news-date">{formatDate(item.date)}</span>
                  {item.link ? (
                    <a href={item.link} target="_blank" rel="noopener">
                      {item.title}
                    </a>
                  ) : (
                    <span class="news-title">{item.title}</span>
                  )}
                </li>
              ))
            }
            <li
              class="empty-note"
              id="event-news-empty"
              style={eventNews.length ? 'display:none' : undefined}
            >
              現在イベントの新着はありません
            </li>
          </ul>
        </div>
        <div class="news-col">
          <h3>お知らせ・読みもの新着</h3>
          <ul class="news-list" id="other-news-list">
            {
              otherNews.length ? (
                otherNews.map((item) => (
                  <li>
                    <span class="news-date">{formatDate(item.date)}</span>
                    {item.tag && <span class="news-tag">{item.tag}</span>}
                    {item.link ? (
                      <a
                        href={item.link}
                        target={item.internal ? undefined : '_blank'}
                        rel={item.internal ? undefined : 'noopener'}
                      >
                        {item.title}
                      </a>
                    ) : (
                      <span class="news-title">{item.title}</span>
                    )}
                  </li>
                ))
              ) : (
                <li class="empty-note">現在お知らせ・読みものの新着はありません</li>
              )
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <Fragment slot="scripts">
  <script is:inline>
    // 次のビルドまでの間に日付が変わっても、終わったイベントが見えないようにする。
    // （ビルド時にも同じ判定をしているが、ブラウザ側でも開催日が過ぎた行を隠す）
    (function () {
      var d = new Date();
      var pad = function (n) { return String(n).padStart(2, '0'); };
      var today = d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate());

      var items = document.querySelectorAll('#event-news-list li[data-date]');
      var visible = 0;
      items.forEach(function (li) {
        if (li.getAttribute('data-date') < today) {
          li.style.display = 'none';
        } else {
          visible++;
        }
      });

      var empty = document.getElementById('event-news-empty');
      if (empty) empty.style.display = visible ? 'none' : '';
    })();
  </script>
  </Fragment>
</Base>
